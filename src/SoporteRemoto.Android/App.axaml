<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoporteRemoto.Android.App"
             RequestedThemeVariant="Light">

  <Application.Resources>

    <FontFamily x:Key="AppFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="CodeFont">monospace</FontFamily>

    <SolidColorBrush x:Key="Accent" Color="#8B5CF6" />
    <SolidColorBrush x:Key="AccentDeep" Color="#4C2E9E" />
    <SolidColorBrush x:Key="AccentSoft" Color="#F1EAFE" />
    <SolidColorBrush x:Key="AppBackground" Color="#F5F1FC" />
    <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Tile" Color="#F6F2FE" />
    <SolidColorBrush x:Key="SoftBorder" Color="#E7E0F5" />
    <SolidColorBrush x:Key="InputBackground" Color="#F8F6FE" />
    <SolidColorBrush x:Key="TextPrimary" Color="#2D2853" />
    <SolidColorBrush x:Key="TextMuted" Color="#8B84A8" />
    <SolidColorBrush x:Key="Success" Color="#18A66A" />
    <SolidColorBrush x:Key="Warning" Color="#D38B00" />
    <SolidColorBrush x:Key="Danger" Color="#E5484D" />
    <SolidColorBrush x:Key="White" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#7C4EEC" Offset="0" />
      <GradientStop Color="#9A5BF0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#5B3DB8" Offset="0" />
      <GradientStop Color="#7C4EEC" Offset="0.6" />
      <GradientStop Color="#9A5BF0" Offset="1" />
    </LinearGradientBrush>

  </Application.Resources>

  <Application.Styles>

    <FluentTheme />

    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="BorderBrush" Value="{StaticResource SoftBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 6 22 0 #146C4FE0" />
    </Style>

    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
      <Setter Property="Foreground" Value="{StaticResource White}" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
      <Setter Property="Foreground" Value="{StaticResource White}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#8455EF" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6C3EDB" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="Foreground" Value="{StaticResource AccentDeep}" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="Foreground" Value="{StaticResource AccentDeep}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E8DDFB" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{StaticResource Danger}" />
      <Setter Property="Foreground" Value="{StaticResource White}" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Danger}" />
      <Setter Property="Foreground" Value="{StaticResource White}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="Foreground" Value="{StaticResource AccentDeep}" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{StaticResource InputBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource SoftBorder}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="ToggleSwitch">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>

    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>

  </Application.Styles>
</Application>
