<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:String x:Key="App_WindowTitle">Nexora · Assistance à distance</x:String>
  <x:String x:Key="Nav_Home">Accueil</x:String>
  <x:String x:Key="Nav_Files">Fichiers</x:String>
  <x:String x:Key="Nav_Settings">Paramètres</x:String>
  <x:String x:Key="Header_Welcome">Bienvenue dans Nexora !</x:String>
  <x:String x:Key="Header_Subtitle">Assistance à distance simple : écran, chat, appels et fichiers.</x:String>
  <x:String x:Key="Header_SettingsTip">Paramètres</x:String>
  <x:String x:Key="Header_LanguageTip">Langue</x:String>
  <x:String x:Key="Status_Online">En ligne</x:String>
  <x:String x:Key="Status_Connecting">Connexion au serveur…</x:String>
  <x:String x:Key="Status_Offline">Pas de connexion Internet</x:String>
  <x:String x:Key="Status_NoServer">Aucun serveur configuré</x:String>
  <x:String x:Key="Status_Disabled">Désactivé</x:String>

  <x:String x:Key="Home_ConnectTitle">Se connecter à un ordinateur</x:String>
  <x:String x:Key="Home_ConnectSubtitle">Saisissez le code affiché sur l'autre ordinateur.</x:String>
  <x:String x:Key="Home_CodeLabel">CODE DE SESSION</x:String>
  <x:String x:Key="Home_ModeScreen">Contrôler l'écran</x:String>
  <x:String x:Key="Home_ModeFiles">Fichiers uniquement</x:String>
  <x:String x:Key="Home_ConnectNow">Se connecter</x:String>
  <x:String x:Key="Home_Connecting">Connexion…</x:String>
  <x:String x:Key="Home_ConnectHint">Connexion automatique via votre réseau local ou Internet.</x:String>
  <x:String x:Key="Home_LanLabel">RÉSEAU LOCAL</x:String>
  <x:String x:Key="Home_SecureLabel">CONNEXION SÉCURISÉE</x:String>
  <x:String x:Key="Home_SecureText">Seule une personne disposant de votre code à 9 caractères peut entrer.</x:String>
  <x:String x:Key="Home_Activity">ACTIVITÉ</x:String>
  <x:String x:Key="Home_MyPc">Mon ordinateur</x:String>
  <x:String x:Key="Home_Allow">Autoriser les connexions</x:String>
  <x:String x:Key="Home_YourCode">VOTRE CODE DE SESSION</x:String>
  <x:String x:Key="Home_CodeChanges">Ce code change à chaque ouverture de Nexora.</x:String>
  <x:String x:Key="Home_NewCode">Nouveau code</x:String>
  <x:String x:Key="Home_CopyTip">Copier le code</x:String>
  <x:String x:Key="Home_HowTitle">COMMENT ÇA MARCHE ?</x:String>
  <x:String x:Key="Home_Step1">Partagez votre code avec la personne qui vous assiste.</x:String>
  <x:String x:Key="Home_Step2">Acceptez la demande qui apparaîtra à l'écran.</x:String>
  <x:String x:Key="Home_Step3">Discutez, parlez et partagez des fichiers pendant la session.</x:String>
  <x:String x:Key="Home_ChatCalls">CHAT ET APPELS</x:String>
  <x:String x:Key="Home_ChatCallsText">Pendant la session, vous pouvez envoyer des messages et lancer un appel audio pour parler tout en fournissant l'assistance.</x:String>
  <x:String x:Key="Home_LanNone">Aucun réseau local détecté.</x:String>

  <x:String x:Key="Files_Title">Transférer des fichiers</x:String>
  <x:String x:Key="Files_Subtitle">Envoyez et recevez des fichiers sans partager ni voir l'écran.</x:String>
  <x:String x:Key="Files_CodeLabel">CODE DE SESSION</x:String>
  <x:String x:Key="Files_Connect">Se connecter pour transférer</x:String>
  <x:String x:Key="Files_ConnectHint">L'autre personne verra une demande pour accepter le transfert. Vous pourrez tous les deux envoyer des fichiers et discuter.</x:String>
  <x:String x:Key="Files_HowTitle">COMMENT ÇA MARCHE ?</x:String>
  <x:String x:Key="Files_Step1">Saisissez le code de l'autre personne.</x:String>
  <x:String x:Key="Files_Step2">L'autre personne accepte le transfert.</x:String>
  <x:String x:Key="Files_Step3">Choisissez les fichiers à envoyer.</x:String>
  <x:String x:Key="Files_Step4">Vous pouvez aussi discuter et utiliser l'appel audio.</x:String>
  <x:String x:Key="Files_ChooseFolder">VOUS CHOISISSEZ OÙ ENREGISTRER</x:String>
  <x:String x:Key="Files_ChooseFolderText">Pour chaque fichier reçu, on vous demande dans quel dossier l'enregistrer. Rien n'est enregistré sans votre accord.</x:String>
  <x:String x:Key="Files_NoScreen">SANS CONTRÔLE DE L'ÉCRAN</x:String>
  <x:String x:Key="Files_NoScreenText">Dans ce mode, l'autre personne ne peut ni voir votre écran ni déplacer la souris. Seuls les fichiers sont transférés.</x:String>

  <x:String x:Key="Settings_RelayTitle">Serveur Internet</x:String>
  <x:String x:Key="Settings_RelaySubtitle">Adresse du serveur relais qui permet de connecter des ordinateurs lorsqu'ils ne sont pas sur le même réseau.</x:String>
  <x:String x:Key="Settings_Save">Enregistrer</x:String>
  <x:String x:Key="Settings_RelayEmpty">Vous pouvez le laisser vide pour utiliser uniquement le réseau local.</x:String>
  <x:String x:Key="Settings_LanTitle">Réseau local</x:String>
  <x:String x:Key="Settings_LanSubtitle">Voici les adresses avec lesquelles les autres ordinateurs de votre réseau peuvent vous trouver.</x:String>
  <x:String x:Key="Settings_Ports">Ports utilisés : TCP 51429 pour les sessions et UDP 51430 pour la découverte. Autorisez-les dans votre pare-feu si le réseau local n'apparaît pas.</x:String>
  <x:String x:Key="Settings_PrivacyTitle">Confidentialité et sécurité</x:String>
  <x:String x:Key="Settings_PrivacyText">• Chaque connexion nécessite votre code à 9 caractères et votre approbation.&#10;• L'écran n'est partagé qu'en mode « Contrôler l'écran ».&#10;• En mode « Fichiers uniquement », personne ne voit ni ne contrôle votre bureau.&#10;• Vous pouvez terminer toute session depuis la fenêtre de session.</x:String>
  <x:String x:Key="Settings_LanguageTitle">Langue</x:String>
  <x:String x:Key="Settings_LanguageSubtitle">Choisissez la langue de l'interface. Elle s'applique immédiatement.</x:String>
  <x:String x:Key="Settings_AboutTitle">À propos de Nexora</x:String>
  <x:String x:Key="Settings_AboutText">Assistance à distance multiplateforme avec chat, appels audio et transfert de fichiers.</x:String>
  <x:String x:Key="Settings_Version">Version 2.0 · Windows, Linux et macOS</x:String>

  <x:String x:Key="Accept_Title">Demande de connexion</x:String>
  <x:String x:Key="Accept_SubtitleScreen">Quelqu'un veut contrôler cet ordinateur</x:String>
  <x:String x:Key="Accept_SubtitleFiles">Quelqu'un veut échanger des fichiers avec vous</x:String>
  <x:String x:Key="Accept_Client">L'ordinateur « {0} » veut se connecter.</x:String>
  <x:String x:Key="Accept_Internet">Connexion via Internet.</x:String>
  <x:String x:Key="Accept_Address">Adresse : {0}</x:String>
  <x:String x:Key="Accept_NoticeScreen">Si vous acceptez, cette personne pourra voir votre écran et contrôler la souris et le clavier de cet ordinateur.</x:String>
  <x:String x:Key="Accept_NoticeFiles">Dans ce mode, l'autre personne ne peut ni voir votre écran ni contrôler la souris. Vous pourrez uniquement échanger des fichiers, discuter et parler en audio.</x:String>
  <x:String x:Key="Accept_Reject">Refuser</x:String>
  <x:String x:Key="Accept_Accept">Accepter et se connecter</x:String>
  <x:String x:Key="Accept_AcceptFiles">Accepter le transfert</x:String>

