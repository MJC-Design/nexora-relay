<UserControl x:Class="SoporteRemoto.Android.ChatPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="MessagesHost" Margin="0,0,4,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border MaxWidth="300"
                    HorizontalAlignment="{Binding Alignment}"
                    Background="{Binding BubbleBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="11,8"
                    Margin="0,0,0,8">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Meta}" FontSize="9.5" FontWeight="Bold"
                           Foreground="{Binding SenderBrush}" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           FontSize="13" LineHeight="18"
                           Foreground="{Binding TextBrush}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBox x:Name="InputBox" Watermark="{DynamicResource Chat_Placeholder}" KeyDown="Input_KeyDown" />
      <Button Grid.Column="1" Width="48" Margin="8,0,0,0" Padding="0"
              Classes="primary" Click="Send_Click">
        <PathIcon Data="M2 21l21-9L2 3v7l15 2-15 2z" Width="17" Height="17" Foreground="White" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
