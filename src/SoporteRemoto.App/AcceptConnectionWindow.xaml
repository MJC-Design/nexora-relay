<Window x:Class="SoporteRemoto.App.AcceptConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solicitud de conexión"
        Height="380" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Style="{StaticResource CardStyle}" Margin="20" Padding="26">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="16" Background="{StaticResource BlueGradient}">
                    <TextBlock x:Name="IconGlyph" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                               Foreground="White" FontSize="19"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Solicitud de conexión" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="Alguien quiere controlar este equipo"
                               Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="ClientText" Margin="0,20,0,0" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="AddressText" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}"
                       FontSize="12.5" TextWrapping="Wrap"/>

            <Border x:Name="NoticeBox" Background="#FEF2F2" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#B91C1C" FontSize="12.5"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Rechazar" Style="{StaticResource SecondaryButton}"
                        IsCancel="True" Width="120" Margin="0,0,10,0" Click="Reject_Click"/>
                <Button x:Name="AcceptButton" Content="Aceptar y conectar" Style="{StaticResource GradientButton}"
                        IsDefault="True" Width="190" Height="44" Click="Accept_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
