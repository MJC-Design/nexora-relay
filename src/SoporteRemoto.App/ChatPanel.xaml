<UserControl x:Class="SoporteRemoto.App.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#FAF8FF" CornerRadius="14" Padding="10,8">
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Messages">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,9" HorizontalAlignment="{Binding Alignment}">
                                <Border MaxWidth="272" CornerRadius="14" Padding="12,8"
                                        Background="{Binding BubbleBrush}"
                                        BorderBrush="{Binding BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sender}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{Binding SenderBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                                   Foreground="{Binding TextBrush}"/>
                                        <TextBlock Text="{Binding Time}" FontSize="9" Margin="0,3,0,0"
                                                   Foreground="{Binding SenderBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Style="{StaticResource ModernTextBox}" MinHeight="42"
                     FontSize="13" KeyDown="Input_KeyDown" ToolTip="Escribe un mensaje…"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Width="44" Height="42"
                    Style="{StaticResource GradientButton}" Padding="0"
                    Click="Send_Click" ToolTip="Enviar mensaje">
                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="White" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
