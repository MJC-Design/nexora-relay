<Window x:Class="SoporteRemoto.App.HostSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoporteRemoto.App"
        Title="Sesión remota activa"
        Height="640" Width="580"
        MinHeight="520" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Style="{StaticResource CardStyle}" Margin="18" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="16" Background="{StaticResource AccentGradient}">
                    <TextBlock x:Name="TitleGlyph" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                               Foreground="White" FontSize="19"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionTitleText" Text="Sesión remota activa" FontSize="19"
                               FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SessionSubtitleText" Text="Tu equipo está siendo controlado"
                               Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource TileStyle}" Margin="0,16,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="CONECTADO CON" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="PeerText" Margin="0,5,0,0" FontSize="13.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AudioCallButton" Content="Iniciar llamada de audio"
                        Style="{StaticResource SecondaryButton}" Click="AudioCall_Click"/>
                <TextBlock x:Name="AudioStatusText" Grid.Column="1" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="CHAT DE LA SESIÓN" Style="{StaticResource SectionLabelStyle}"/>
                <local:ChatPanel x:Name="ChatArea" Grid.Row="1" Margin="0,8,0,0"/>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Enviar archivo" Style="{StaticResource SecondaryButton}"
                        Width="140" Margin="0,0,10,0" Click="SendFile_Click"/>
                <Button Content="Finalizar sesión" Style="{StaticResource DangerButton}"
                        Width="150" Click="End_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
