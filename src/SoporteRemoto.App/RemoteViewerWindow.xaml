<Window x:Class="SoporteRemoto.App.RemoteViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoporteRemoto.App"
        Title="Soporte remoto"
        Height="760" Width="1180"
        MinHeight="540" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="#140F2E"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#241B4B" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="SendFileButton" Content="Enviar archivo" Style="{StaticResource ToolbarButton}" Click="SendFile_Click"/>
                    <Button x:Name="PullFileButton" Content="Traer archivo" Style="{StaticResource ToolbarButton}" Click="PullFile_Click"/>
                    <Border Width="1" Height="20" Background="#3F3468" Margin="6,0" VerticalAlignment="Center"/>
                    <Button x:Name="ChatButton" Content="Chat" Style="{StaticResource ToolbarButton}" Click="ToggleChat_Click"/>
                    <Button x:Name="AudioButton" Content="Llamada de audio" Style="{StaticResource ToolbarButton}" Click="Audio_Click"/>
                    <Border Width="1" Height="20" Background="#3F3468" Margin="6,0" VerticalAlignment="Center"/>
                    <Button x:Name="FullScreenButton" Content="Pantalla completa" Style="{StaticResource ToolbarButton}" Click="FullScreen_Click"/>
                    <Button x:Name="DisconnectButton" Content="Desconectar" Style="{StaticResource DangerButton}"
                            Padding="14,7" FontSize="12" Height="34" Margin="8,0,0,0" Click="Disconnect_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#C9BFF0"
                           VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Background="Black" ClipToBounds="True">
                <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True" Cursor="Cross"
                       MouseMove="ScreenImage_MouseMove"
                       MouseDown="ScreenImage_MouseDown"
                       MouseUp="ScreenImage_MouseUp"
                       MouseWheel="ScreenImage_MouseWheel"
                       PreviewKeyDown="ScreenImage_PreviewKeyDown"
                       PreviewKeyUp="ScreenImage_PreviewKeyUp"/>
                <Canvas x:Name="CursorCanvas" IsHitTestVisible="False">
                    <Ellipse x:Name="CursorDot" Width="14" Height="14" Fill="#FFE066"
                             Stroke="#111827" StrokeThickness="2" Visibility="Collapsed"/>
                </Canvas>
            </Grid>

            <Border x:Name="ChatPane" Grid.Column="1" Width="336" Background="#FFFFFF"
                    Visibility="Collapsed">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,10">
                        <TextBlock Text="Chat de la sesión" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30"
                                Content="&#xE711;" FontSize="12" HorizontalAlignment="Right"
                                Click="ToggleChat_Click" ToolTip="Cerrar chat"/>
                    </DockPanel>
                    <local:ChatPanel x:Name="ChatArea" Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#241B4B" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="AudioStatusText" Foreground="#7CE3C0" VerticalAlignment="Center"
                               Margin="0,0,14,0" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TransferText" Foreground="#E5E7EB" VerticalAlignment="Center"
                               Margin="0,0,10,0" FontSize="11.5"/>
                    <ProgressBar x:Name="TransferBar" Width="200" Height="7" Minimum="0" Maximum="100" Value="0"
                                 Foreground="{StaticResource AccentBrush}" Background="#3F3468" BorderThickness="0"/>
                </StackPanel>
                <TextBlock x:Name="InfoText" Foreground="#C9BFF0" VerticalAlignment="Center" FontSize="11.5"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
