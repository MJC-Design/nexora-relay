<Window x:Class="SoporteRemoto.Desktop.AcceptConnectionWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource AppFont}"
        Title="Nexora">
  <Border Background="White" CornerRadius="24" Margin="14" Padding="28"
          BoxShadow="0 12 44 0 #386D4DB8">
    <StackPanel Spacing="0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="50" Height="50" CornerRadius="16" Background="{StaticResource AccentSoft}">
          <Image Source="avares://Nexora/Assets/logo-mark.png" Width="36" Height="30" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="{DynamicResource Accept_Title}"
                     FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentDeep}" />
          <TextBlock x:Name="SubtitleText" Text="{DynamicResource Accept_SubtitleScreen}"
                     FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
        </StackPanel>
        <Border Grid.Column="2" x:Name="ModeBadge" Background="{StaticResource AccentSoft}"
                CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
          <TextBlock x:Name="ModeText" Text="{DynamicResource Home_ModeScreen}"
                     FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Accent}" />
        </Border>
      </Grid>

      <Border Background="{StaticResource Tile}" CornerRadius="14" Padding="16,13" Margin="0,22,0,0"
              BorderBrush="{StaticResource SoftBorder}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="38" Height="38" CornerRadius="12" Background="White">
            <PathIcon Data="M21 3H3a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h7v2H8v2h8v-2h-2v-2h7a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"
                      Width="18" Height="18" Foreground="{StaticResource Accent}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ClientText" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
            <TextBlock x:Name="AddressText" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                       Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="NoticeBox" Background="#FFF8EE" BorderBrush="#F6DFC0" BorderThickness="1"
              CornerRadius="13" Padding="14,12" Margin="0,16,0,0">
        <Grid ColumnDefinitions="Auto,*">
          <PathIcon x:Name="NoticeIcon"
                    Data="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5zm0 5a2 2 0 0 1 2 2v4h-4V9a2 2 0 0 1 2-2zm0 9.5a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6z"
                    Width="17" Height="17" Foreground="#C98300" VerticalAlignment="Top" Margin="0,1,0,0" />
          <TextBlock x:Name="NoticeText" Grid.Column="1" Margin="10,0,0,0"
                     FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="#8A6100"
                     Text="{DynamicResource Accept_NoticeScreen}" />
        </Grid>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,24,0,0">
        <Button x:Name="RejectButton" Theme="{StaticResource SecondaryButtonTheme}"
                MinWidth="116" Height="44" Content="{DynamicResource Accept_Reject}"
                Click="Reject_Click" />
        <Button x:Name="AcceptButton" Theme="{StaticResource GradientButtonTheme}"
                MinWidth="190" Height="44" Content="{DynamicResource Accept_Accept}"
                IsDefault="True" Click="Accept_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
