<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:String x:Key="App_WindowTitle">Nexora · Remote support</x:String>
  <x:String x:Key="Nav_Home">Home</x:String>
  <x:String x:Key="Nav_Files">Files</x:String>
  <x:String x:Key="Nav_Settings">Settings</x:String>
  <x:String x:Key="Header_Welcome">Welcome to Nexora!</x:String>
  <x:String x:Key="Header_Subtitle">Simple remote support: screen, chat, calls and files.</x:String>
  <x:String x:Key="Header_SettingsTip">Settings</x:String>
  <x:String x:Key="Header_LanguageTip">Language</x:String>
  <x:String x:Key="Status_Online">Online</x:String>
  <x:String x:Key="Status_Connecting">Connecting to server…</x:String>
  <x:String x:Key="Status_Offline">No Internet connection</x:String>
  <x:String x:Key="Status_NoServer">No server configured</x:String>
  <x:String x:Key="Status_Disabled">Disabled</x:String>

  <x:String x:Key="Home_ConnectTitle">Connect to a computer</x:String>
  <x:String x:Key="Home_ConnectSubtitle">Enter the code shown on the other computer.</x:String>
  <x:String x:Key="Home_CodeLabel">SESSION CODE</x:String>
  <x:String x:Key="Home_ModeScreen">Control screen</x:String>
  <x:String x:Key="Home_ModeFiles">Files only</x:String>
  <x:String x:Key="Home_ConnectNow">Connect now</x:String>
  <x:String x:Key="Home_Connecting">Connecting…</x:String>
  <x:String x:Key="Home_ConnectHint">Connects automatically over your local network or the Internet.</x:String>
  <x:String x:Key="Home_LanLabel">LOCAL NETWORK</x:String>
  <x:String x:Key="Home_SecureLabel">SECURE CONNECTION</x:String>
  <x:String x:Key="Home_SecureText">Only someone with your 9-character code can get in.</x:String>
  <x:String x:Key="Home_Activity">ACTIVITY</x:String>
  <x:String x:Key="Home_MyPc">My computer</x:String>
  <x:String x:Key="Home_Allow">Allow connections</x:String>
  <x:String x:Key="Home_YourCode">YOUR SESSION CODE</x:String>
  <x:String x:Key="Home_CodeChanges">This code changes every time you open Nexora.</x:String>
  <x:String x:Key="Home_NewCode">New code</x:String>
  <x:String x:Key="Home_CopyTip">Copy code</x:String>
  <x:String x:Key="Home_HowTitle">HOW DOES IT WORK?</x:String>
  <x:String x:Key="Home_Step1">Share your code with the support person.</x:String>
  <x:String x:Key="Home_Step2">Accept the request that appears on your screen.</x:String>
  <x:String x:Key="Home_Step3">Chat, talk and share files during the session.</x:String>
  <x:String x:Key="Home_ChatCalls">CHAT AND CALLS</x:String>
  <x:String x:Key="Home_ChatCallsText">During the session you can send messages and start an audio call to talk while you provide support.</x:String>
  <x:String x:Key="Home_LanNone">No local network was detected.</x:String>

  <x:String x:Key="Files_Title">Transfer files</x:String>
  <x:String x:Key="Files_Subtitle">Send and receive files without sharing or viewing the screen.</x:String>
  <x:String x:Key="Files_CodeLabel">SESSION CODE</x:String>
  <x:String x:Key="Files_Connect">Connect to transfer</x:String>
  <x:String x:Key="Files_ConnectHint">The other person will see a request to accept the transfer. You will both be able to send files and chat.</x:String>
  <x:String x:Key="Files_HowTitle">HOW DOES IT WORK?</x:String>
  <x:String x:Key="Files_Step1">Enter the other person's code.</x:String>
  <x:String x:Key="Files_Step2">The other person accepts the transfer.</x:String>
  <x:String x:Key="Files_Step3">Choose the files you want to send.</x:String>
  <x:String x:Key="Files_Step4">You can also chat and use the audio call.</x:String>
  <x:String x:Key="Files_ChooseFolder">YOU CHOOSE WHERE TO SAVE</x:String>
  <x:String x:Key="Files_ChooseFolderText">Every received file asks you which folder to save it in. Nothing is saved without your permission.</x:String>
  <x:String x:Key="Files_NoScreen">NO SCREEN CONTROL</x:String>
  <x:String x:Key="Files_NoScreenText">In this mode the other person cannot see your screen or move your mouse. Only files are transferred.</x:String>

  <x:String x:Key="Settings_RelayTitle">Internet server</x:String>
  <x:String x:Key="Settings_RelaySubtitle">Address of the relay server that connects computers when they are not on the same network.</x:String>
  <x:String x:Key="Settings_Save">Save</x:String>
  <x:String x:Key="Settings_RelayEmpty">You can leave it empty to use the local network only.</x:String>
  <x:String x:Key="Settings_LanTitle">Local network</x:String>
  <x:String x:Key="Settings_LanSubtitle">These are the addresses other computers on your network can use to find you.</x:String>
  <x:String x:Key="Settings_Ports">Ports used: TCP 51429 for sessions and UDP 51430 for discovery. Allow them in your firewall if the local network does not appear.</x:String>
  <x:String x:Key="Settings_PrivacyTitle">Privacy and security</x:String>
  <x:String x:Key="Settings_PrivacyText">• Every connection needs your 9-character code and your approval.&#10;• The screen is only shared in “Control screen” mode.&#10;• In “Files only” mode nobody sees or controls your desktop.&#10;• You can end any session from the session window.</x:String>
  <x:String x:Key="Settings_LanguageTitle">Language</x:String>
  <x:String x:Key="Settings_LanguageSubtitle">Choose the interface language. It applies instantly.</x:String>
  <x:String x:Key="Settings_AboutTitle">About Nexora</x:String>
  <x:String x:Key="Settings_AboutText">Cross-platform remote support with chat, audio calls and file transfer.</x:String>
  <x:String x:Key="Settings_Version">Version 2.0 · Windows, Linux and macOS</x:String>

  <x:String x:Key="Accept_Title">Connection request</x:String>
  <x:String x:Key="Accept_SubtitleScreen">Someone wants to control this computer</x:String>
  <x:String x:Key="Accept_SubtitleFiles">Someone wants to exchange files with you</x:String>
  <x:String x:Key="Accept_Client">The computer “{0}” wants to connect.</x:String>
  <x:String x:Key="Accept_Internet">Connection over the Internet.</x:String>
  <x:String x:Key="Accept_Address">Address: {0}</x:String>
  <x:String x:Key="Accept_NoticeScreen">If you accept, this person will be able to see your screen and control this computer's mouse and keyboard.</x:String>
  <x:String x:Key="Accept_NoticeFiles">In this mode the other person cannot see your screen or control the mouse. They can only exchange files, chat and talk over audio.</x:String>
  <x:String x:Key="Accept_Reject">Decline</x:String>
  <x:String x:Key="Accept_Accept">Accept and connect</x:String>
  <x:String x:Key="Accept_AcceptFiles">Accept transfer</x:String>

