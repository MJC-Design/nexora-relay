<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:String x:Key="App_WindowTitle">Nexora · Soporte remoto</x:String>
  <x:String x:Key="Nav_Home">Inicio</x:String>
  <x:String x:Key="Nav_Files">Archivos</x:String>
  <x:String x:Key="Nav_Settings">Ajustes</x:String>
  <x:String x:Key="Header_Welcome">¡Bienvenido a Nexora!</x:String>
  <x:String x:Key="Header_Subtitle">Asistencia remota simple: pantalla, chat, llamadas y archivos.</x:String>
  <x:String x:Key="Header_SettingsTip">Ajustes</x:String>
  <x:String x:Key="Header_LanguageTip">Idioma</x:String>
  <x:String x:Key="Status_Online">En línea</x:String>
  <x:String x:Key="Status_Connecting">Conectando al servidor…</x:String>
  <x:String x:Key="Status_Offline">Sin conexión a Internet</x:String>
  <x:String x:Key="Status_NoServer">Sin servidor configurado</x:String>
  <x:String x:Key="Status_Disabled">Desactivado</x:String>

  <x:String x:Key="Home_ConnectTitle">Conectar a un equipo</x:String>
  <x:String x:Key="Home_ConnectSubtitle">Escribe el código que aparece en la otra computadora.</x:String>
  <x:String x:Key="Home_CodeLabel">CÓDIGO DE SESIÓN</x:String>
  <x:String x:Key="Home_ModeScreen">Controlar pantalla</x:String>
  <x:String x:Key="Home_ModeFiles">Solo archivos</x:String>
  <x:String x:Key="Home_ConnectNow">Conectar ahora</x:String>
  <x:String x:Key="Home_Connecting">Conectando…</x:String>
  <x:String x:Key="Home_ConnectHint">Se conecta automáticamente por tu red local o por Internet.</x:String>
  <x:String x:Key="Home_LanLabel">RED LOCAL</x:String>
  <x:String x:Key="Home_SecureLabel">CONEXIÓN SEGURA</x:String>
  <x:String x:Key="Home_SecureText">Solo entra quien tenga tu código de 9 caracteres.</x:String>
  <x:String x:Key="Home_Activity">ACTIVIDAD</x:String>
  <x:String x:Key="Home_MyPc">Mi equipo</x:String>
  <x:String x:Key="Home_Allow">Permitir conexiones</x:String>
  <x:String x:Key="Home_YourCode">TU CÓDIGO DE SESIÓN</x:String>
  <x:String x:Key="Home_CodeChanges">Este código cambia cada vez que abres Nexora.</x:String>
  <x:String x:Key="Home_NewCode">Nuevo código</x:String>
  <x:String x:Key="Home_CopyTip">Copiar código</x:String>
  <x:String x:Key="Home_HowTitle">¿CÓMO FUNCIONA?</x:String>
  <x:String x:Key="Home_Step1">Comparte tu código con la persona de soporte.</x:String>
  <x:String x:Key="Home_Step2">Acepta la solicitud que aparecerá en tu pantalla.</x:String>
  <x:String x:Key="Home_Step3">Chatea, habla y comparte archivos durante la sesión.</x:String>
  <x:String x:Key="Home_ChatCalls">CHAT Y LLAMADAS</x:String>
  <x:String x:Key="Home_ChatCallsText">Durante la sesión puedes escribir mensajes y activar una llamada de audio para hablar mientras brindas soporte.</x:String>
  <x:String x:Key="Home_LanNone">No se detectó ninguna red local.</x:String>

  <x:String x:Key="Files_Title">Transferir archivos</x:String>
  <x:String x:Key="Files_Subtitle">Envía y recibe archivos sin compartir ni ver la pantalla.</x:String>
  <x:String x:Key="Files_CodeLabel">CÓDIGO DE SESIÓN</x:String>
  <x:String x:Key="Files_Connect">Conectar para transferir</x:String>
  <x:String x:Key="Files_ConnectHint">La otra persona verá una solicitud para aceptar la transferencia. Ambos podrán enviarse archivos y chatear.</x:String>
  <x:String x:Key="Files_HowTitle">¿CÓMO FUNCIONA?</x:String>
  <x:String x:Key="Files_Step1">Escribe el código de la otra persona.</x:String>
  <x:String x:Key="Files_Step2">La otra persona acepta la transferencia.</x:String>
  <x:String x:Key="Files_Step3">Elige los archivos que quieres enviar.</x:String>
  <x:String x:Key="Files_Step4">También pueden chatear y usar la llamada de audio.</x:String>
  <x:String x:Key="Files_ChooseFolder">TÚ ELIGES DÓNDE GUARDAR</x:String>
  <x:String x:Key="Files_ChooseFolderText">Cada archivo recibido te pregunta en qué carpeta guardarlo. Nada se guarda sin tu permiso.</x:String>
  <x:String x:Key="Files_NoScreen">SIN CONTROL DE PANTALLA</x:String>
  <x:String x:Key="Files_NoScreenText">En este modo la otra persona no puede ver tu pantalla ni mover el ratón. Solo se transfieren archivos.</x:String>

  <x:String x:Key="Settings_RelayTitle">Servidor de Internet</x:String>
  <x:String x:Key="Settings_RelaySubtitle">Dirección del servidor relay que permite conectar equipos cuando no están en la misma red.</x:String>
  <x:String x:Key="Settings_Save">Guardar</x:String>
  <x:String x:Key="Settings_RelayEmpty">Puedes dejarlo vacío para usar únicamente la red local.</x:String>
  <x:String x:Key="Settings_LanTitle">Red local</x:String>
  <x:String x:Key="Settings_LanSubtitle">Estas son las direcciones con las que otros equipos de tu red pueden encontrarte.</x:String>
  <x:String x:Key="Settings_Ports">Puertos usados: TCP 51429 para las sesiones y UDP 51430 para el descubrimiento. Permítelos en el firewall si la red local no aparece.</x:String>
  <x:String x:Key="Settings_PrivacyTitle">Privacidad y seguridad</x:String>
  <x:String x:Key="Settings_PrivacyText">• Cada conexión necesita tu código de 9 caracteres y tu aprobación.&#10;• La pantalla solo se comparte en el modo «Controlar pantalla».&#10;• En el modo «Solo archivos» nadie ve ni controla tu escritorio.&#10;• Puedes finalizar cualquier sesión desde la ventana de la sesión.</x:String>
  <x:String x:Key="Settings_LanguageTitle">Idioma</x:String>
  <x:String x:Key="Settings_LanguageSubtitle">Elige el idioma de la interfaz. Se aplica al instante.</x:String>
  <x:String x:Key="Settings_AboutTitle">Acerca de Nexora</x:String>
  <x:String x:Key="Settings_AboutText">Soporte remoto multiplataforma con chat, llamadas de audio y transferencia de archivos.</x:String>
  <x:String x:Key="Settings_Version">Versión 2.0 · Windows, Linux y macOS</x:String>

  <x:String x:Key="Accept_Title">Solicitud de conexión</x:String>
  <x:String x:Key="Accept_SubtitleScreen">Alguien quiere controlar este equipo</x:String>
  <x:String x:Key="Accept_SubtitleFiles">Quieren intercambiar archivos contigo</x:String>
  <x:String x:Key="Accept_Client">El equipo «{0}» quiere conectarse.</x:String>
  <x:String x:Key="Accept_Internet">Conexión a través de Internet.</x:String>
  <x:String x:Key="Accept_Address">Dirección: {0}</x:String>
  <x:String x:Key="Accept_NoticeScreen">Si aceptas, esta persona podrá ver tu pantalla y controlar el ratón y el teclado de este equipo.</x:String>
  <x:String x:Key="Accept_NoticeFiles">En este modo la otra persona no puede ver tu pantalla ni controlar el ratón. Solo podrán intercambiar archivos, chatear y hablar por audio.</x:String>
  <x:String x:Key="Accept_Reject">Rechazar</x:String>
  <x:String x:Key="Accept_Accept">Aceptar y conectar</x:String>
  <x:String x:Key="Accept_AcceptFiles">Aceptar transferencia</x:String>

