<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:String x:Key="App_WindowTitle">Nexora · Assistenza remota</x:String>
  <x:String x:Key="Nav_Home">Home</x:String>
  <x:String x:Key="Nav_Files">File</x:String>
  <x:String x:Key="Nav_Settings">Impostazioni</x:String>
  <x:String x:Key="Header_Welcome">Benvenuto in Nexora!</x:String>
  <x:String x:Key="Header_Subtitle">Assistenza remota semplice: schermo, chat, chiamate e file.</x:String>
  <x:String x:Key="Header_SettingsTip">Impostazioni</x:String>
  <x:String x:Key="Header_LanguageTip">Lingua</x:String>
  <x:String x:Key="Status_Online">In linea</x:String>
  <x:String x:Key="Status_Connecting">Connessione al server…</x:String>
  <x:String x:Key="Status_Offline">Nessuna connessione Internet</x:String>
  <x:String x:Key="Status_NoServer">Nessun server configurato</x:String>
  <x:String x:Key="Status_Disabled">Disattivato</x:String>

  <x:String x:Key="Home_ConnectTitle">Connetti a un computer</x:String>
  <x:String x:Key="Home_ConnectSubtitle">Inserisci il codice mostrato sull'altro computer.</x:String>
  <x:String x:Key="Home_CodeLabel">CODICE DI SESSIONE</x:String>
  <x:String x:Key="Home_ModeScreen">Controlla schermo</x:String>
  <x:String x:Key="Home_ModeFiles">Solo file</x:String>
  <x:String x:Key="Home_ConnectNow">Connetti ora</x:String>
  <x:String x:Key="Home_Connecting">Connessione…</x:String>
  <x:String x:Key="Home_ConnectHint">Si connette automaticamente tramite la rete locale o Internet.</x:String>
  <x:String x:Key="Home_LanLabel">RETE LOCALE</x:String>
  <x:String x:Key="Home_SecureLabel">CONNESSIONE SICURA</x:String>
  <x:String x:Key="Home_SecureText">Solo chi possiede il tuo codice di 9 caratteri può accedere.</x:String>
  <x:String x:Key="Home_Activity">ATTIVITÀ</x:String>
  <x:String x:Key="Home_MyPc">Il mio computer</x:String>
  <x:String x:Key="Home_Allow">Consenti connessioni</x:String>
  <x:String x:Key="Home_YourCode">IL TUO CODICE DI SESSIONE</x:String>
  <x:String x:Key="Home_CodeChanges">Questo codice cambia ogni volta che apri Nexora.</x:String>
  <x:String x:Key="Home_NewCode">Nuovo codice</x:String>
  <x:String x:Key="Home_CopyTip">Copia codice</x:String>
  <x:String x:Key="Home_HowTitle">COME FUNZIONA?</x:String>
  <x:String x:Key="Home_Step1">Condividi il tuo codice con la persona dell'assistenza.</x:String>
  <x:String x:Key="Home_Step2">Accetta la richiesta che apparirà sullo schermo.</x:String>
  <x:String x:Key="Home_Step3">Chatta, parla e condividi file durante la sessione.</x:String>
  <x:String x:Key="Home_ChatCalls">CHAT E CHIAMATE</x:String>
  <x:String x:Key="Home_ChatCallsText">Durante la sessione puoi inviare messaggi e avviare una chiamata audio per parlare mentre offri assistenza.</x:String>
  <x:String x:Key="Home_LanNone">Nessuna rete locale rilevata.</x:String>

  <x:String x:Key="Files_Title">Trasferisci file</x:String>
  <x:String x:Key="Files_Subtitle">Invia e ricevi file senza condividere né vedere lo schermo.</x:String>
  <x:String x:Key="Files_CodeLabel">CODICE DI SESSIONE</x:String>
  <x:String x:Key="Files_Connect">Connetti per trasferire</x:String>
  <x:String x:Key="Files_ConnectHint">L'altra persona vedrà una richiesta per accettare il trasferimento. Entrambi potrete inviare file e chattare.</x:String>
  <x:String x:Key="Files_HowTitle">COME FUNZIONA?</x:String>
  <x:String x:Key="Files_Step1">Inserisci il codice dell'altra persona.</x:String>
  <x:String x:Key="Files_Step2">L'altra persona accetta il trasferimento.</x:String>
  <x:String x:Key="Files_Step3">Scegli i file che vuoi inviare.</x:String>
  <x:String x:Key="Files_Step4">Puoi anche chattare e usare la chiamata audio.</x:String>
  <x:String x:Key="Files_ChooseFolder">SCEGLI TU DOVE SALVARE</x:String>
  <x:String x:Key="Files_ChooseFolderText">Per ogni file ricevuto ti viene chiesto in quale cartella salvarlo. Nulla viene salvato senza il tuo permesso.</x:String>
  <x:String x:Key="Files_NoScreen">NESSUN CONTROLLO DELLO SCHERMO</x:String>
  <x:String x:Key="Files_NoScreenText">In questa modalità l'altra persona non può vedere il tuo schermo né muovere il mouse. Vengono trasferiti solo file.</x:String>

  <x:String x:Key="Settings_RelayTitle">Server Internet</x:String>
  <x:String x:Key="Settings_RelaySubtitle">Indirizzo del server relay che consente di collegare computer quando non sono sulla stessa rete.</x:String>
  <x:String x:Key="Settings_Save">Salva</x:String>
  <x:String x:Key="Settings_RelayEmpty">Puoi lasciarlo vuoto per usare solo la rete locale.</x:String>
  <x:String x:Key="Settings_LanTitle">Rete locale</x:String>
  <x:String x:Key="Settings_LanSubtitle">Questi sono gli indirizzi con cui gli altri computer della tua rete possono trovarti.</x:String>
  <x:String x:Key="Settings_Ports">Porte utilizzate: TCP 51429 per le sessioni e UDP 51430 per il rilevamento. Consentile nel firewall se la rete locale non appare.</x:String>
  <x:String x:Key="Settings_PrivacyTitle">Privacy e sicurezza</x:String>
  <x:String x:Key="Settings_PrivacyText">• Ogni connessione richiede il tuo codice di 9 caratteri e la tua approvazione.&#10;• Lo schermo viene condiviso solo in modalità «Controlla schermo».&#10;• In modalità «Solo file» nessuno vede o controlla la tua scrivania.&#10;• Puoi terminare qualsiasi sessione dalla finestra della sessione.</x:String>
  <x:String x:Key="Settings_LanguageTitle">Lingua</x:String>
  <x:String x:Key="Settings_LanguageSubtitle">Scegli la lingua dell'interfaccia. Si applica subito.</x:String>
  <x:String x:Key="Settings_AboutTitle">Informazioni su Nexora</x:String>
  <x:String x:Key="Settings_AboutText">Assistenza remota multipiattaforma con chat, chiamate audio e trasferimento file.</x:String>
  <x:String x:Key="Settings_Version">Versione 2.0 · Windows, Linux e macOS</x:String>

  <x:String x:Key="Accept_Title">Richiesta di connessione</x:String>
  <x:String x:Key="Accept_SubtitleScreen">Qualcuno vuole controllare questo computer</x:String>
  <x:String x:Key="Accept_SubtitleFiles">Qualcuno vuole scambiare file con te</x:String>
  <x:String x:Key="Accept_Client">Il computer «{0}» vuole connettersi.</x:String>
  <x:String x:Key="Accept_Internet">Connessione tramite Internet.</x:String>
  <x:String x:Key="Accept_Address">Indirizzo: {0}</x:String>
  <x:String x:Key="Accept_NoticeScreen">Se accetti, questa persona potrà vedere il tuo schermo e controllare mouse e tastiera di questo computer.</x:String>
  <x:String x:Key="Accept_NoticeFiles">In questa modalità l'altra persona non può vedere il tuo schermo né controllare il mouse. Potrete solo scambiare file, chattare e parlare in audio.</x:String>
  <x:String x:Key="Accept_Reject">Rifiuta</x:String>
  <x:String x:Key="Accept_Accept">Accetta e connetti</x:String>
  <x:String x:Key="Accept_AcceptFiles">Accetta trasferimento</x:String>

