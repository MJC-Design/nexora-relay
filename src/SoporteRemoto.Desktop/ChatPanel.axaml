<UserControl x:Class="SoporteRemoto.Desktop.ChatPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
  <UserControl.Resources>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#B7A8D8" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBox.glass">
      <Setter Property="Foreground" Value="#F5F0FF" />
      <Setter Property="CaretBrush" Value="White" />
    </Style>
    <Style Selector="TextBox.glass /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
    </Style>
    <Style Selector="TextBox.glass /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="#B7A8D8" />
    </Style>
    <Style Selector="TextBox.glass:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#59FFFFFF" />
    </Style>
    <Style Selector="TextBox.glass:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#2EFFFFFF" />
      <Setter Property="BorderBrush" Value="#C58B5CF6" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="MessagesHost" Margin="0,0,4,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border MaxWidth="330"
                    HorizontalAlignment="{Binding Alignment}"
                    Background="{Binding BubbleBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="11,8"
                    Margin="0,0,0,9">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Meta}" FontSize="9.5" FontWeight="Bold"
                           Foreground="{Binding SenderBrush}" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           FontSize="12.5" LineHeight="18"
                           Foreground="{Binding TextBrush}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBox x:Name="InputBox" Classes="modern"
               Watermark="{DynamicResource Chat_Placeholder}"
               KeyDown="Input_KeyDown" />
      <Button Grid.Column="1" Width="44" Height="42" Margin="8,0,0,0" Padding="0"
              AutomationProperties.AutomationId="ChatSend"
              Theme="{StaticResource GradientButtonTheme}"
              Click="Send_Click" ToolTip.Tip="{DynamicResource Chat_SendTip}">
        <PathIcon Data="M2 21l21-9L2 3v7l15 2-15 2z" Width="17" Height="17" Foreground="White" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
