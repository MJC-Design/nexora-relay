<Window x:Class="SoporteRemoto.Desktop.FileTransferWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SoporteRemoto.Desktop"
        Width="960" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

  <Grid RowDefinitions="Auto,*">

    <Border Background="{StaticResource SidebarGradient}" Padding="24,20">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="46" Height="46" CornerRadius="15" Background="#F2FFFFFF">
          <Image Source="avares://Nexora/Assets/logo-mark.png" Width="34" Height="28" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="{DynamicResource Transfer_Header}"
                     FontSize="19" FontWeight="Bold" Foreground="White" />
          <TextBlock x:Name="PeerText" Text="" FontSize="11" Foreground="#D9C7FA" Margin="0,5,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="AudioStatusText" Text="" FontSize="11" Foreground="#E5D6FF"
                     VerticalAlignment="Center" MaxWidth="220" TextWrapping="Wrap" />
          <Button x:Name="AudioCallButton" Theme="{StaticResource ToolbarButtonTheme}"
                  Content="{DynamicResource Host_StartAudio}" Click="AudioCall_Click" />
          <Button x:Name="EndButton" Theme="{StaticResource DangerButtonTheme}"
                  Content="{DynamicResource Viewer_Disconnect}" Click="End_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="22" ColumnDefinitions="1.05*,16,*">

      <StackPanel Spacing="16">
        <Border Classes="card">
          <StackPanel>
            <TextBlock Text="{DynamicResource Transfer_Status}" Classes="section" />
            <TextBlock x:Name="TransferText" Text="{DynamicResource Transfer_SessionStatus}"
                       FontSize="12.5" Foreground="#5E5578" Margin="0,9,0,12" TextWrapping="Wrap" />
            <ProgressBar x:Name="TransferBar" Minimum="0" Maximum="1" Value="0" Height="8" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
              <Button x:Name="SendFileButton" Theme="{StaticResource GradientButtonTheme}" Click="SendFile_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <PathIcon Data="M19 9h-4V3H9v6H5l7 7zM5 18v2h14v-2z"
                            Width="13" Height="13" Foreground="White" />
                  <TextBlock Text="{DynamicResource Host_SendFile}" />
                </StackPanel>
              </Button>
              <Button x:Name="PullFileButton" Theme="{StaticResource SecondaryButtonTheme}" Click="PullFile_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <PathIcon Data="M5 15h4v6h6v-6h4l-7-7zM5 3h14v2H5z"
                            Width="13" Height="13" Foreground="{StaticResource AccentDeep}" />
                  <TextBlock Text="{DynamicResource Transfer_Pull}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="tile" Background="{StaticResource TileMint}">
          <StackPanel>
            <Border Width="40" Height="40" CornerRadius="13" Background="White">
              <PathIcon Data="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5z"
                        Width="18" Height="18" Foreground="{StaticResource Success}" />
            </Border>
            <TextBlock Text="{DynamicResource Transfer_NoScreen}" Classes="section" Foreground="#1B7A55"
                       Margin="0,14,0,0" />
            <TextBlock Text="{DynamicResource Transfer_NoScreenText}" FontSize="11.5" Margin="0,7,0,0"
                       Foreground="#3E6B5B" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Column="2" Classes="card" Padding="20,18">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="{DynamicResource Host_Chat}" Classes="section" />
          <local:ChatPanel x:Name="ChatArea" Grid.Row="1" Margin="0,12,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
