<Window x:Class="SoporteRemoto.Desktop.HostSessionWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SoporteRemoto.Desktop"
        Width="980" Height="660" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

  <Grid RowDefinitions="Auto,*">

    <Border Background="{StaticResource SidebarGradient}" Padding="24,20" ClipToBounds="True">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="46" Height="46" CornerRadius="15" Background="#F2FFFFFF">
          <Image Source="avares://Nexora/Assets/logo-mark.png" Width="34" Height="28" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
          <TextBlock x:Name="SessionTitleText" Text="{DynamicResource Host_TitleScreen}"
                     FontSize="19" FontWeight="Bold" Foreground="White" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
            <Border Background="#26FFFFFF" CornerRadius="10" Padding="8,3">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="M21 3H3a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h7v2H8v2h8v-2h-2v-2h7a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"
                          Width="11" Height="11" Foreground="#E9DDFB" VerticalAlignment="Center" />
                <TextBlock x:Name="PeerText" Text="—" FontSize="10.5" Foreground="#EDE2FF"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="SessionSubtitleText" Text="{DynamicResource Host_SubtitleScreen}"
                       FontSize="11" Foreground="#D9C7FA" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="AudioStatusText" Text="" FontSize="11" Foreground="#E5D6FF"
                     VerticalAlignment="Center" MaxWidth="230" TextWrapping="Wrap" />
          <Button x:Name="VideoCallButton" Theme="{StaticResource ToolbarButtonTheme}"
                  Content="{DynamicResource Video_Invite}" Click="VideoCall_Click" />
          <Button x:Name="AudioCallButton" Theme="{StaticResource ToolbarButtonTheme}"
                  Content="{DynamicResource Host_StartAudio}" Click="AudioCall_Click" />
          <Button x:Name="EndButton" Theme="{StaticResource DangerButtonTheme}"
                  Content="{DynamicResource Host_EndSession}" Click="End_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="22" ColumnDefinitions="1.05*,16,*" RowDefinitions="*">

      <StackPanel Spacing="16">
        <Border Classes="card">
          <StackPanel>
            <TextBlock Text="{DynamicResource Transfer_Status}" Classes="section" />
            <TextBlock x:Name="TransferText" Text="{DynamicResource Transfer_ScreenStatus}"
                       FontSize="12.5" Foreground="#5E5578" Margin="0,9,0,12" TextWrapping="Wrap" />
            <ProgressBar x:Name="TransferBar" Minimum="0" Maximum="1" Value="0" Height="8" />
            <Button Theme="{StaticResource GradientButtonTheme}" Margin="0,14,0,0"
                    HorizontalAlignment="Left" Click="SendFile_Click">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="M21 3H3a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h7v2H8v2h8v-2h-2v-2h7a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"
                          Width="13" Height="13" Foreground="White" />
                <TextBlock Text="{DynamicResource Host_SendFile}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <Border Width="40" Height="40" CornerRadius="13" Background="{StaticResource AccentSoft}">
              <PathIcon Data="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5z"
                        Width="18" Height="18" Foreground="{StaticResource Accent}" />
            </Border>
            <TextBlock x:Name="SessionNoteText" Text="{DynamicResource Host_NoteScreen}"
                       FontSize="12.5" Foreground="#5E5578" Margin="0,12,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Column="2" Classes="card" Padding="20,18">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="{DynamicResource Host_Chat}" Classes="section" />
          <local:ChatPanel x:Name="ChatArea" Grid.Row="1" Margin="0,12,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
