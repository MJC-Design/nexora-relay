<Window x:Class="SoporteRemoto.Desktop.MessageDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource AppFont}"
        Title="Nexora">
  <Border Background="White" CornerRadius="22" Margin="14" Padding="26" BoxShadow="0 10 38 0 #306D4DB8">
    <Grid RowDefinitions="Auto,Auto,Auto">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
          <PathIcon Data="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5zm0 5a2 2 0 0 1 2 2v4h-4V9a2 2 0 0 1 2-2zm0 9.5a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6z"
                    Width="24" Height="24" Foreground="{StaticResource Accent}" />
        </Border>
        <TextBlock x:Name="TitleText" Grid.Column="1" Text="Nexora" Margin="14,2,0,0"
                   FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentDeep}"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
      </Grid>
      <TextBlock x:Name="MessageText" Grid.Row="1" Text="" Margin="2,20,2,0"
                 FontSize="13.5" LineHeight="21" Foreground="#554E6E" TextWrapping="Wrap" />
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="10" Margin="0,26,0,0">
        <Button x:Name="SecondaryButton" Theme="{StaticResource SecondaryButtonTheme}"
                MinWidth="104" IsVisible="False" Content="" Click="Secondary_Click" />
        <Button x:Name="PrimaryButton" Theme="{StaticResource GradientButtonTheme}"
                MinWidth="120" Content="OK" IsDefault="True" Click="Primary_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
