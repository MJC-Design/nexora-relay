<Window x:Class="SoporteRemoto.Desktop.VideoCallWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SoporteRemoto.Desktop"
        Width="1020" Height="700" MinWidth="640" MinHeight="460"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0C1D"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

  <Window.Styles>
    <Style Selector="Button.chat-close">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.chat-close:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.chat-close:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="#26FFFFFF" />
    </Style>

    <Style Selector="ComboBox.device">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="Foreground" Value="#F3EDFF" />
      <Setter Property="BorderBrush" Value="#3DFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.device:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <Border Background="{StaticResource SidebarGradient}" Padding="18,12"
            PointerPressed="Header_PointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="40" Height="40" CornerRadius="13" Background="#F2FFFFFF">
          <Image Source="avares://Nexora/Assets/logo-mark.png" Width="29" Height="24" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="{DynamicResource Video_Title}"
                     FontSize="16" FontWeight="Bold" Foreground="White" />
          <TextBlock x:Name="SubtitleText" Text="{DynamicResource Video_Subtitle}" FontSize="10.5"
                     Foreground="#D9C7FA" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="ChatButton" Theme="{StaticResource ToolbarButtonTheme}"
                  Content="{DynamicResource Viewer_Chat}" Click="ToggleChat_Click">
            <Button.ContentTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"
                            Width="13" Height="13" Foreground="#F3E8FF" />
                  <TextBlock Text="{Binding}" Foreground="#F3E8FF" />
                </StackPanel>
              </DataTemplate>
            </Button.ContentTemplate>
          </Button>

          <Button x:Name="AudioButton" Theme="{StaticResource ToolbarButtonTheme}"
                  Content="{DynamicResource Video_MicOn}" Click="Audio_Click" />

          <Button x:Name="EndButton" Theme="{StaticResource DangerButtonTheme}"
                  Content="{DynamicResource Video_End}" Click="End_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#141026" Padding="16,7"
            BorderBrush="#241C3D" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,18,*" VerticalAlignment="Center">
        <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
          <TextBlock Text="{DynamicResource Video_Camera}" FontSize="10.5" Foreground="#A996D6"
                     VerticalAlignment="Center" />
          <ComboBox x:Name="CameraBox" Grid.Column="1" Classes="device" Margin="8,0,0,0"
                    SelectionChanged="Camera_SelectionChanged"
                    ToolTip.Tip="{DynamicResource Video_Camera}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <Grid Grid.Column="2" ColumnDefinitions="Auto,*">
          <TextBlock Text="{DynamicResource Video_Microphone}" FontSize="10.5" Foreground="#A996D6"
                     VerticalAlignment="Center" />
          <ComboBox x:Name="MicBox" Grid.Column="1" Classes="device" Margin="8,0,0,0"
                    SelectionChanged="Mic_SelectionChanged"
                    ToolTip.Tip="{DynamicResource Video_Microphone}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="16,14,16,10">

      <Border CornerRadius="18" Background="#0A0814" ClipToBounds="True"
              BorderBrush="#2C2347" BorderThickness="1">
        <Grid>
          <Image x:Name="RemoteImage" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />

          <Border x:Name="WaitingBox" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="#CC1B1530" CornerRadius="20" Padding="30,24">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
              <Border Width="72" Height="72" CornerRadius="36" Background="#2EFFFFFF"
                      HorizontalAlignment="Center">
                <PathIcon Data="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11z"
                          Width="28" Height="28" Foreground="#D9C7FA" Opacity="0.9" />
              </Border>
              <TextBlock x:Name="WaitingText" Text="{DynamicResource Video_Waiting}"
                         FontSize="12.5" Foreground="#CFC3EC" HorizontalAlignment="Center"
                         TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center" />
            </StackPanel>
          </Border>

          <Canvas x:Name="PipLayer" SizeChanged="PipLayer_SizeChanged">
            <Border x:Name="LocalPip" Width="218" Height="152"
                    CornerRadius="15" Background="#1B1530"
                    BorderBrush="#4DFFFFFF" BorderThickness="1" ClipToBounds="True"
                    BoxShadow="0 10 30 0 #80110A24" Cursor="SizeAll"
                    ToolTip.Tip="{DynamicResource Video_PipHint}"
                    PointerPressed="Pip_PointerPressed"
                    PointerMoved="Pip_PointerMoved"
                    PointerReleased="Pip_PointerReleased">
              <Grid>
                <TextBlock Text="{DynamicResource Video_You}" FontSize="11" Foreground="#6F678E"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="LocalImage" Stretch="UniformToFill" />
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,10"
                        Background="#99000000" CornerRadius="7" Padding="7,2">
                  <TextBlock Text="{DynamicResource Video_You}" FontSize="9.5" Foreground="#EDE2FF" />
                </Border>
                <Border x:Name="PipGrip" Width="20" Height="20" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,0,4,4" CornerRadius="6"
                        Background="#591C1536" Cursor="BottomRightCorner"
                        ToolTip.Tip="{DynamicResource Video_PipHint}"
                        PointerPressed="PipGrip_PointerPressed">
                  <PathIcon Data="M17 7L7 17M17 12v5h-5" Width="9" Height="9" Foreground="#D9C7FA" />
                </Border>
              </Grid>
            </Border>
          </Canvas>
        </Grid>
      </Border>

      <Border x:Name="ChatPane" IsVisible="False"
              Width="320" Height="366"
              HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="16,0,0,30"
              CornerRadius="18" Padding="14,12"
              Background="#E61C1536"
              BorderBrush="#3DFFFFFF" BorderThickness="1"
              BoxShadow="0 18 46 0 #80120A28">
        <Border.Resources>
          <Color x:Key="ScrollBarThumbBackgroundColor">#66FFFFFF</Color>
          <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#59FFFFFF" />
          <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#1FFFFFFF" />
        </Border.Resources>
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,0,0,10">
            <Border Width="26" Height="26" CornerRadius="9" Background="#26FFFFFF">
              <Image Source="avares://Nexora/Assets/logo-mark.png" Width="18" Height="15" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Viewer_ChatTitle}"
                         FontSize="12.5" FontWeight="Bold" Foreground="White" />
              <TextBlock x:Name="ChatOverlaySubtitle" Text="" FontSize="9.5"
                         Foreground="#C9BCE8" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Classes="chat-close" Theme="{StaticResource IconButtonTheme}"
                    Click="ToggleChat_Click" Width="26" Height="26" Padding="0"
                    VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Viewer_CloseChat}">
              <PathIcon Data="M6 6l12 12M18 6L6 18" Width="11" Height="11" Foreground="#E4DBF6" />
            </Button>
          </Grid>
          <local:ChatPanel x:Name="ChatArea" Grid.Row="1" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="#191430" Padding="18,9">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="#12B76A" VerticalAlignment="Center" />
          <TextBlock x:Name="CallStatusText" Text="{DynamicResource Video_Connected}"
                     FontSize="11.5" Foreground="#D6CCF2" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="VideoStatusText" Grid.Column="2" Text="" FontSize="11"
                   Foreground="#F5C26B" VerticalAlignment="Center" TextWrapping="Wrap"
                   MaxWidth="560" TextAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</Window>
